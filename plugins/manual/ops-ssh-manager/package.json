{
  "name": "ops-ssh-manager",
  "version": "0.1.2",
  "description": "DSH 原生运维管理插件：插件配置区管理页（主机 / SSH 密钥 / 导入导出 / 审查等级）+ 方法调用 SSH 工具（ssh_exec / ssh_list_hosts）+ 严格模式强制审批（单次 / 本 session），密钥与密码经 credentials 服务隔离，绝不出 Host。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "test",
    "client.js",
    "cordis.patch.yml",
    "scripts/preflight.mjs",
    "scripts/migrate-roster-v2.mjs",
    "DESIGN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE-MCP-SSH-MANAGER"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "ssh",
    "ops",
    "approval"
  ]
}
