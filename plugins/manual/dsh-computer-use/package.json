{
  "name": "dsh-computer-use",
  "version": "0.1.0",
  "description": "DSH 视觉整机控制插件（P2）：经 macOS Accessibility API（AXUIElement）把本机 GUI app 变成 AX 快照优先的元素级工具集（观察 4 + 动作 6 + 截图兜底 1，共 11 个 computer_* 工具）；Swift 辅助进程零 npm 依赖；敏感动作可选人工审批（默认关）；computer_screenshot 落盘返路径，读图走 modlens_read_image。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "driver",
    "test",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "engines": {
    "node": ">=22",
    "darwin": ">=14"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "build-driver": "swiftc -O -o driver/axdriver driver/axdriver.swift"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "computer-use",
    "accessibility",
    "axuielement",
    "macos"
  ]
}
